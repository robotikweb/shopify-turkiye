{%- comment -%}
  WhatsApp ile sor / sipariş ver butonu (ürün sayfası)
  https://github.com/robotikweb/shopify-turkiye · MIT

  Kullanım:
    {% render 'whatsapp-siparis', product: product, numara: '905xxxxxxxxx' %}

  numara: ülke koduyla, başında + ve boşluk olmadan (ör. 905321234567).
  Mesaja ürün adı, seçili varyant ve ürün bağlantısı otomatik eklenir; varyant değişince güncellenir.
{%- endcomment -%}
{%- liquid
  assign numara = numara | remove: '+' | remove: ' '
  assign varyant = product.selected_or_first_available_variant
  capture urun_linki
    echo shop.url | append: product.url
  endcapture
  capture mesaj
    echo 'Merhaba, bu ürün hakkında bilgi almak istiyorum: ' | append: product.title
    unless product.has_only_default_variant
      echo ' (' | append: varyant.title | append: ')'
    endunless
    echo ' ' | append: urun_linki
  endcapture
-%}
{%- if numara != blank -%}
<a class="whatsapp-siparis button button--secondary"
   href="https://wa.me/{{ numara }}?text={{ mesaj | strip | url_encode }}"
   target="_blank" rel="noopener"
   data-wa-numara="{{ numara }}" data-wa-urun="{{ product.title | escape }}" data-wa-link="{{ urun_linki | strip | escape }}"
   style="display:inline-flex; align-items:center; gap:.5rem; margin-top:.75rem;">
  <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.5-.3z"/></svg>
  WhatsApp ile sor
</a>
<script>
(function () {
  var a = document.currentScript.previousElementSibling;
  if (!a || !a.dataset.waNumara) return;
  function guncelle(varyantAdi) {
    var m = 'Merhaba, bu ürün hakkında bilgi almak istiyorum: ' + a.dataset.waUrun +
      (varyantAdi && varyantAdi !== 'Default Title' ? ' (' + varyantAdi + ')' : '') + ' ' + a.dataset.waLink;
    a.href = 'https://wa.me/' + a.dataset.waNumara + '?text=' + encodeURIComponent(m);
  }
  // Online Store 2.0 temalarının çoğu varyant değişince URL'deki ?variant= değerini günceller
  var son = '';
  setInterval(function () {
    var id = new URLSearchParams(location.search).get('variant');
    if (!id || id === son) return;
    son = id;
    fetch(location.pathname.replace(/\/$/, '') + '.js').then(function (r) { return r.json(); }).then(function (p) {
      var v = (p.variants || []).filter(function (x) { return String(x.id) === id; })[0];
      if (v) guncelle(v.title);
    }).catch(function () {});
  }, 800);
})();
</script>
{%- endif -%}
